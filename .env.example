# Zyte API Key (https://app.zyte.com/o/ORG_ID/zyte-api/api-access)
API_KEY=your_api_key_here

# Optional alias/endpoint override for the direct Zyte API Playwright runner.
# ZYTE_API_KEY takes precedence over API_KEY when both are set.
# ZYTE_API_KEY=your_api_key_here
ZYTE_API_PROXY_SERVER=http://api.zyte.com:8011
# Optional Zyte API proxy-mode IP type, for example residential.
# ZYTE_IP_TYPE=residential

# Zyte CDP WebSocket (optional overrides)
ZYTE_CDP_ENDPOINT=wss://pop-us.browser.zyte.com/wss?ttl=180
CDP_SMOKE_URL=https://example.com/

# CDP target tests are non-submitting by default. Enable only when intended.
FREEPEOPLEDIRECTORY_PROFILE_URL=https://www.freepeopledirectory.com/person/Richard-Smith/Dallas-TX/p10281241131
FREEPEOPLEDIRECTORY_SUBMIT=false
BEENVERIFIED_SUBMIT_SEARCH=false
BEENVERIFIED_STOP_AFTER_CONTINUE=false

# Smart Proxy Manager API Key (https://app.zyte.com/o/ORG_ID/smart-proxy-manager)   
SPM_API_KEY=your_api_key_here

# 2Captcha API Key (https://2captcha.com/enterpage)
TWO_CAPTCHA_KEY=your_api_key_here


####################################################################
# Zyte Smartproxy Headless Proxy configuration (https://github.com/zytedata/zyte-smartproxy-headless-proxy)

# Documentation: https://docs.zyte.com/smart-proxy-manager/headless.html#using-headless-browsers-with-zyte-smart-proxy-manager
# Required
CRAWLERA_API_KEY=your_api_key_here

# Optional overrides
CRAWLERA_HOST=proxy.crawlera.com
CRAWLERA_PORT=8010
CRAWLERA_NO_AUTO_SESSIONS=false
CRAWLERA_CONCURRENT_CONNECTIONS=0
CRAWLERA_DONT_VERIFY=false

# Comma-separated xheader pairs, e.g. profile=desktop,cookies=disable
CRAWLERA_XHEADERS=

# Local listen port for the proxy
SPM_LOCAL_PORT=3128
