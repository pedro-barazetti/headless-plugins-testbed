    "axios-proxy-csv-compare": "ts-node headless-proxy/axios_proxy_csv_comparison.ts",
    "selenium-proxy": "ts-node headless-proxy/selenium_proxy.ts",
    "selenium-proxy-csv": "ts-node headless-proxy/selenium_proxy_csv_input.ts",
    "puppeteer-proxy": "ts-node headless-proxy/puppeteer_proxy.ts",
    "splash-up": "docker compose --env-file .env -f splash/compose.yaml up -d --wait",
    "splash-proxy-test": "ts-node splash/zyte_api_proxy_compatibility.ts",
