{
  "name": "Zyte-headless-plugins-testbed",
  "version": "1.0.0",
  "description": "Zyte headless plugin testbed (Playwright / Selenium / Puppeteer + Headless Proxy)",
  "private": true,
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck",
    "cdp:smoke": "ts-node cdp-websocket/smoke.ts",
    "cdp:freepeopledirectory": "ts-node cdp-websocket/freepeopledirectory.ts",
    "cdp:beenverified": "ts-node cdp-websocket/beenverified.ts",
