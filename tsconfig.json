{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    "moduleResolution": "node",
    "strict": true,
    "useUnknownInCatchVariables": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "dist",
    "types": ["node"],
    "typeRoots": ["./types", "./node_modules/@types"],
    "lib": ["ES2021", "DOM"],
    "resolveJsonModule": true
  },
  "ts-node": {
    "files": true,
    "compilerOptions": {
      "typeRoots": ["./types", "./node_modules/@types"]
    }
  },
  "include": [
    "src",
    "types",
    "cdp-websocket/**/*.ts",
    "playwright-2captcha/**/*.ts",
    "headless-proxy/selenium_proxy.ts",
    "headless-proxy/axios_proxy_csv_comparison.ts",
    "headless-proxy/playwright_proxy_csv_input.ts",
    "headless-proxy/playwright_zyte_api_direct_csv.ts",
    "puppeteer/platpat.ts",
    "headless-proxy/playwright_proxy.ts",
    "puppeteer/informdata_courts.ts",
    "headless-proxy/puppeteer_proxy.ts",
    "splash/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
